{
  "manifest_version": 3,
  "name": "키이스케이프 예약 도우미",
  "version": "0.3.0",
  "description": "예약 오픈 시각에 예약 페이지를 열고 수동 CAPTCHA 후 예약을 진행합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "tabs"
  ],
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "키이스케이프 예약 도우미",
    "default_popup": "extension/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/keyescape-site.js",
        "extension/runner.js"
      ],
      "matches": [
        "https://www.keyescape.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://www.keyescape.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.keyescape.com/reservation1.php*",
        "https://www.keyescape.com/reservation2.php*",
        "https://www.keyescape.com/reservation3.php*"
      ],
      "js": [
        "extension/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
